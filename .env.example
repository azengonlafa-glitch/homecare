# Growa Homecare - ตัวแปรสภาพแวดล้อม (ตัวอย่าง)
# ไม่เก็บรหัสผ่านหรือความลับใดๆ ในไฟล์นี้
VITE_APP_TITLE="Growa Homecare"

# Supabase (Project Settings -> API) ใช้ anon key เท่านั้น ห้ามใส่ service_role key
# ถ้าไม่ตั้งค่า แอปจะทำงานแบบต้นแบบเดิม (เก็บในเครื่อง + ปุ่ม Demo)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ระบบปรึกษา: mock = โหมดทดสอบ เก็บในเครื่อง, supabase = ใช้งานจริง (ต้องรัน supabase/consult_schema.sql ก่อน)
VITE_CONSULT_BACKEND=mock

# แจ้งเตือนนัดติดตาม (Web Push) ใส่เฉพาะกุญแจสาธารณะ กุญแจส่วนตัวเก็บใน Edge Function secret เท่านั้น
VITE_VAPID_PUBLIC_KEY=

# โทรเสียง/วิดีโอคอล (WebRTC) ใช้ STUN ฟรีของ Google เป็นค่าเริ่มต้น ถ้าเครือข่ายบางแห่งต่อกันตรงไม่ได้ ต้องมีเซิร์ฟเวอร์ TURN
# ใส่หลายลิงก์คั่นด้วยจุลภาค เช่น turn:turn.example.com:3478,turns:turn.example.com:5349 (ค่านี้ฝังในแอป จึงควรใช้บัญชีที่จำกัดโควตา)
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
